# Copy to .env and fill in. docker compose reads this file automatically.
POSTGRES_PASSWORD=change-me-please
PUBLIC_BASE_URL=https://relay.example.com
ADMIN_EMAILS=you@example.com

# Optional email delivery for subscriptions and failure notices.
SMTP_ADDR=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@relayradar.local
ALERT_FAILURE_EMAIL=

# Optional favicon proxy (icons only, audits never use it).
FAVICON_PROXY_URL=
